# GEMINI_API_KEY: Required for Gemini AI API calls.
# Configure this value as a protected secret in the deployment platform.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
AI_PROVIDER="gemini"

# APP_URL: The URL where this applet is hosted.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Local development database. Change the Prisma datasource provider and this
# URL to postgresql before production deployment.
DATABASE_URL="file:./data/system.db"
DATABASE_PROVIDER="sqlite"
BACKUP_DIRECTORY="backups"
PARKING_QR_SECRET="CAMBIAR_POR_UN_SECRETO_ALEATORIO_LARGO"
MFA_ENCRYPTION_KEY="GENERAR_32_BYTES_EN_BASE64"

# Google Workspace OAuth credentials supplied by the institutional IT team.
GOOGLE_CLASSROOM_CLIENT_ID=""
GOOGLE_CLASSROOM_CLIENT_SECRET=""
GOOGLE_CLASSROOM_REDIRECT_URI="http://localhost:3000/api/google/callback"

# Institutional SMTP credentials. Notifications remain safely queued when
# these values are empty.
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT="465"
SMTP_USER="alertas@kynova.tech"
SMTP_PASS=""
SMTP_FROM="Sistema Académico USPG <alertas@kynova.tech>"
