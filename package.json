{
  "name": "uspg-sistema-academico",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build",
    "preview": "NODE_ENV=production tsx server.ts",
    "start": "NODE_ENV=production tsx server.ts",
    "start:production": "npm run production:check && npm run db:postgres:migrate:deploy && npm run start",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:postgres:prepare": "node scripts/prepare-postgresql-schema.mjs",
    "db:postgres:generate": "npm run db:postgres:prepare && prisma generate --config prisma.postgresql.config.ts",
    "db:postgres:push": "npm run db:postgres:prepare && prisma db push --config prisma.postgresql.config.ts",
    "db:postgres:migrate:deploy": "npm run db:postgres:prepare && prisma migrate deploy --config prisma.postgresql.config.ts",
    "production:check": "node scripts/check-production-env.mjs",
    "backup:create": "node scripts/backup-database.mjs",
    "backup:verify": "node scripts/verify-backup.mjs",
    "test:roles": "node scripts/test-role-access.mjs",
    "test:library": "node scripts/test-library-flow.mjs",
    "test:mfa": "node scripts/test-mfa.mjs",
    "verify:release": "npm run lint && npm run build && npm audit --omit=dev",
    "db:import:systems-curriculum": "tsx scripts/import-systems-curriculum.ts",
    "db:seed": "tsx prisma/seed.ts",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@prisma/adapter-better-sqlite3": "^7.9.1",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@tailwindcss/vite": "^4.1.14",
    "@types/nodemailer": "^8.0.1",
    "@types/pdfkit": "^0.17.6",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "html5-qrcode": "^2.3.8",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "nodemailer": "^9.0.3",
    "pdfkit": "^0.19.1",
    "pg": "^8.22.0",
    "prisma": "^7.9.1",
    "qrcode": "^1.5.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "^8.3.0",
    "recharts": "^3.10.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/qrcode": "^1.5.6",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
